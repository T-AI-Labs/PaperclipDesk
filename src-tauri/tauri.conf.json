{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperclipDesk",
  "version": "1.4.0",
  "identifier": "local.paperclipdesk",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1440",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PaperclipDesk",
        "width": 860,
        "height": 700,
        "minWidth": 680,
        "minHeight": 520,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERERkNCM0UxQTNDNDdFRTIKUldUaWZzU2o0YlA4M2IxcEVWL1czSis3eCt0Y2RCSzE1VFhsVFI2YzVTN3pUaG96RVZ2RkhZSDUK",
      "endpoints": [
        "https://github.com/T-AI-Labs/PaperclipDesk/releases/latest/download/latest.json"
      ]
    }
  }
}
