{
  "name": "paperclipdesk",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "npm run dev",
    "npm:install": "npm ci",
    "postinstall": "npm --prefix ui install",
    "dev": "cd crates/paperclipdesk && npx --prefix ../../ui tauri dev",
    "prepare-server": "node scripts/prepare-server.mjs",
    "bundle-server": "node scripts/bundle-server.mjs",
    "prepare-server-ui": "node scripts/build-ui.mjs",
    "pack-server": "node scripts/pack-server.mjs",
    "licenses": "node scripts/create-licenses.mjs",
    "build": "cd crates/paperclipdesk && npx --prefix ../../ui tauri build --no-bundle",
    "dist": "cd crates/paperclipdesk && npx --prefix ../../ui tauri build",
    "check": "cargo clippy -p paperclipdesk --all-targets -- -D warnings && cargo test -p paperclipdesk && npm --prefix ui run build && npm --prefix ui run lint",
    "app:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1"
  },
  "paperclip": {
    "server": "2026.1001.0",
    "teamsCatalog": "2026.824.0",
    "overrides": {
      "@anthropic-ai/sdk": "0.91.1",
      "@tootallnate/once": "2.0.1",
      "@xmldom/xmldom": "0.8.13",
      "@hono/node-server": "1.19.17",
      "better-auth": "1.7.2",
      "body-parser": "2.3.0",
      "brace-expansion@1.1.12": "1.1.18",
      "brace-expansion@1.1.13": "1.1.18",
      "brace-expansion@2.0.2": "2.1.4",
      "brace-expansion@2.0.3": "2.1.4",
      "brace-expansion@5.0.5": "5.0.9",
      "brace-expansion@5.0.6": "5.0.9",
      "defu": "6.1.7",
      "dompurify": "3.4.14",
      "esbuild": "0.28.2",
      "fast-uri": "3.1.6",
      "fast-xml-parser": "5.7.3",
      "form-data": "4.0.6",
      "hono": "4.13.4",
      "ip-address": "10.5.0",
      "js-yaml": "4.3.1",
      "kysely": "0.28.17",
      "lodash": "4.18.1",
      "multer": "2.2.0",
      "path-to-regexp": "8.4.2",
      "qs": "6.15.2",
      "tar": "7.5.22",
      "tmp": "0.2.7",
      "undici@5.29.0": "6.28.0",
      "undici@6.25.0": "6.28.0",
      "undici@7.24.6": "7.29.0",
      "undici@7.28.0": "7.29.0",
      "ws": "8.21.3"
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
