{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The app's own webview: Tauri core defaults plus the app commands. Paperclip windows get no capability.",
  "webviews": [
    "shell"
  ],
  "permissions": [
    "core:default",
    "allow-launcher-state",
    "allow-set-open-at-start",
    "allow-activate-connection",
    "allow-close-connection",
    "allow-menu-action",
    "allow-set-menu-open",
    "allow-save-remote-profile",
    "allow-duplicate-profile",
    "allow-delete-profile",
    "allow-verify-remote",
    "allow-cancel-connect",
    "allow-connect-local",
    "allow-connect-remote",
    "allow-connect-saved-profile",
    "allow-return-to-current-session",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-log",
    "allow-clear-log",
    "allow-open-data-folder",
    "allow-open-project-link",
    "allow-get-about",
    "allow-show-page",
    "allow-server-info",
    "allow-restart-local-server",
    "allow-reinstall-server",
    "allow-read-server-config",
    "allow-write-server-config",
    "allow-reset-local-server",
    "allow-export-settings",
    "allow-import-settings",
    "allow-check-for-updates",
    "allow-install-update"
  ]
}
